# 统一换行符，避免 Windows / macOS / Linux 之间产生无意义的差异
* text=auto eol=lf

# 明确二进制文件，不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# 构建产物与锁文件在 diff 中折叠
package-lock.json linguist-generated=true
dist/** linguist-generated=true
