{
  "name": "sorting-visualizer",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "description": "排序算法可视化 —— 9 种算法的 2D/3D 实时演示，含步骤解说、复杂度分析与双语界面",
  "keywords": [
    "sorting-algorithms",
    "visualization",
    "three.js",
    "canvas",
    "education",
    "vite"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "serve": "python -m http.server 3000 --bind 127.0.0.1 --directory dist",
    "test": "npm run test:algorithms && npm run test:runtime",
    "test:algorithms": "node tests/test-algorithms.mjs",
    "test:runtime": "node tests/smoke-test.cjs"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=18"
  }
}
